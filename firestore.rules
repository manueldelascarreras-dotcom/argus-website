rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pilot requests from the "Book a pilot" form.
    // Anyone can submit one; nobody can read, edit or delete them from the browser.
    // View them in the Firebase console (Firestore > pilotRequests).
    match /pilotRequests/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['name','business','email','phone','type','tools','message','createdAt','source'])
        && request.resource.data.name is string     && request.resource.data.name.size() > 0     && request.resource.data.name.size() <= 120
        && request.resource.data.business is string && request.resource.data.business.size() > 0 && request.resource.data.business.size() <= 160
        && request.resource.data.email is string    && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$') && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string    && request.resource.data.phone.size() <= 40
        && request.resource.data.type is string     && request.resource.data.type.size() <= 60
        && request.resource.data.tools is list      && request.resource.data.tools.size() <= 10
        && request.resource.data.message is string  && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
